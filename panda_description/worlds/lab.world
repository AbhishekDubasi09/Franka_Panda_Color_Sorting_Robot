<?xml version="1.0"?>
<!--
  Work cell for the colour-sorting demo. Everything is built from SDF
  primitives, so the world has no external mesh or model dependencies.

  Frames: the Panda base sits at world (0.6, 0, 0.35), yaw 1.57 rad (see
  virtual_joint in arm.xacro), so the table top is at z = 0.35 and the pucks
  start on the camera axis at world (0.6, 0.6).
-->
<sdf version="1.9">
  <world name="lab_world">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.93 0.94 0.96 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.62 0.64 0.67 1</ambient>
            <diffuse>0.62 0.64 0.67 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Work table: graphite top, steel legs. Top surface at z = 0.35. -->
    <model name="work_table">
      <static>true</static>
      <pose>0.75 0.1 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.33 0 0 0</pose>
          <geometry><box><size>1.1 1.6 0.04</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.33 0 0 0</pose>
          <geometry><box><size>1.1 1.6 0.04</size></box></geometry>
          <material>
            <ambient>0.17 0.18 0.2 1</ambient>
            <diffuse>0.17 0.18 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="leg_a">
          <pose>0.5 0.75 0.155 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.31</size></box></geometry>
          <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse></material>
        </visual>
        <visual name="leg_b">
          <pose>-0.5 0.75 0.155 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.31</size></box></geometry>
          <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse></material>
        </visual>
        <visual name="leg_c">
          <pose>0.5 -0.75 0.155 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.31</size></box></geometry>
          <material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.7 0.72 0.75 1</diffuse></material>
        </visual>
        <visual name="leg_d">
          <pose>-0.5 -0.75 0.155 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.31</size></box></geometry>
          <material><ambient>0.7 0.72 0.75 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Colour bins (one per colour), behind the robot. Floors are tinted. -->
    <model name="bin_red">
      <static>true</static>
      <pose>1.035 -0.116 0.35 0 0 0</pose>
      <link name="link">
        <collision name="floor_collision"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.18 0.18 0.012</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.18 0.18 0.012</size></box></geometry><material><ambient>0.95 0.80 0.80 1</ambient><diffuse>0.95 0.80 0.80 1</diffuse></material></visual>
        <collision name="wall_n_collision"><pose>0 0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry></collision>
        <visual name="wall_n_visual"><pose>0 0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_s_collision"><pose>0 -0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry></collision>
        <visual name="wall_s_visual"><pose>0 -0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_e_collision"><pose>0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry></collision>
        <visual name="wall_e_visual"><pose>0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_w_collision"><pose>-0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry></collision>
        <visual name="wall_w_visual"><pose>-0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bin_green">
      <static>true</static>
      <pose>0.918 -0.318 0.35 0 0 0</pose>
      <link name="link">
        <collision name="floor_collision"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.18 0.18 0.012</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.18 0.18 0.012</size></box></geometry><material><ambient>0.80 0.93 0.82 1</ambient><diffuse>0.80 0.93 0.82 1</diffuse></material></visual>
        <collision name="wall_n_collision"><pose>0 0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry></collision>
        <visual name="wall_n_visual"><pose>0 0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_s_collision"><pose>0 -0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry></collision>
        <visual name="wall_s_visual"><pose>0 -0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_e_collision"><pose>0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry></collision>
        <visual name="wall_e_visual"><pose>0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_w_collision"><pose>-0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry></collision>
        <visual name="wall_w_visual"><pose>-0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bin_blue">
      <static>true</static>
      <pose>0.716 -0.435 0.35 0 0 0</pose>
      <link name="link">
        <collision name="floor_collision"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.18 0.18 0.012</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.006 0 0 0</pose><geometry><box><size>0.18 0.18 0.012</size></box></geometry><material><ambient>0.80 0.85 0.97 1</ambient><diffuse>0.80 0.85 0.97 1</diffuse></material></visual>
        <collision name="wall_n_collision"><pose>0 0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry></collision>
        <visual name="wall_n_visual"><pose>0 0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_s_collision"><pose>0 -0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry></collision>
        <visual name="wall_s_visual"><pose>0 -0.08399999999999999 0.047 0 0 0</pose><geometry><box><size>0.18 0.012 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_e_collision"><pose>0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry></collision>
        <visual name="wall_e_visual"><pose>0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
        <collision name="wall_w_collision"><pose>-0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry></collision>
        <visual name="wall_w_visual"><pose>-0.08399999999999999 0 0.047 0 0 0</pose><geometry><box><size>0.012 0.18 0.07</size></box></geometry><material><ambient>0.82 0.83 0.86 1</ambient><diffuse>0.82 0.83 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pucks: 60 mm diameter, 60 mm tall, resting on the table (z = 0.38). -->
    <model name="red_puck">
      <pose>0.6 0.6 0.38 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>5.25e-5</ixx><iyy>5.25e-5</iyy><izz>4.5e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_puck">
      <pose>0.8 0.6 0.38 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>5.25e-5</ixx><iyy>5.25e-5</iyy><izz>4.5e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.75 0.2 1</ambient><diffuse>0.1 0.75 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_puck">
      <pose>0.4 0.6 0.38 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>5.25e-5</ixx><iyy>5.25e-5</iyy><izz>4.5e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
